# La misma DATABASE_URL que AlMinisterio (Postgres estándar: Supabase o Neon).
# El driver HTTP de Neon no conecta a Supabase: este sitio usa `pg`.
# En Netlify: Site settings → Environment variables. Sin prefijo NEXT_PUBLIC_.
DATABASE_URL=

# Secreto del servidor, mínimo 32 caracteres aleatorios. No usar prefijo NEXT_PUBLIC_.
# Crear con: openssl rand -hex 32
SUBMISSION_RATE_LIMIT_SECRET=

# Solo un encabezado que el proveedor SOBRESCRIBA con la IP real del cliente.
# Netlify: x-nf-client-connection-ip. Si falta/no es una IP, se usa un límite compartido.
SUBMISSION_TRUSTED_IP_HEADER=x-nf-client-connection-ip

# Cron privado de Netlify: desactivado hasta verificar migraciones y correo.
ALMINISTERIO_CRON_ENABLED=false
ALMINISTERIO_CRON_URL=https://al-ministerio.vercel.app/api/cron/tick
ALMINISTERIO_CRON_SECRET=
# Solo si el deployment de AlMinisterio exige bypass de automatización.
ALMINISTERIO_AUTOMATION_BYPASS_SECRET=
